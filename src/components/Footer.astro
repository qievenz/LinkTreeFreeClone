---
export interface Props {
	title: string;
	tagline: string;
}

const { title, tagline } = Astro.props;
---
<footer>
    <div class="mx-auto max-w-7xl py-12 px-4 sm:px-6 md:flex md:items-center md:justify-center lg:px-8">
        <div class="mt-8 md:order-1 md:mt-0 flex flex-col items-center">
            <p class="text-center text-base text-secondary-text">
                &copy; 2022 {title}. {tagline}
            </p>
            <p class="text-center text-base text-secondary-text mt-2 flex gap-4">
                <a href="/privacy" class="text-accent hover:underline">Privacy Policy</a>
                <span class="opacity-30">|</span>
                <a href="/terms" class="text-accent hover:underline">Terms of Service</a>
            </p>
            <p class="text-center text-base text-secondary-text mt-2">
                Make with <a href="https://github.com/yoanbernabeu/LinkTreeFreeClone" class="text-accent">LinkTreeFreeClone</a>
            </p>
        </div>
    </div>
</footer>